# ====================================================================
# GuriHel — tusaale environment. KU DHAQAAQ:  make init
# (make init wuxuu abuuraa .env cusub oo leh sirro random ah)
# HA COMMIT GAREYN .env. Ha isticmaalin qiimayaasha hoose production-ka.
# ====================================================================

# --- Docker infra (infra/docker-compose.yml) ---
POSTGRES_USER=gurihel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=gurihel
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=gurihel_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MIN_8_CHARS

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://gurihel:CHANGE_ME@127.0.0.1:5432/gurihel
# Jaangooyooyin la oggol yahay (comma-separated). Production: ha isticmaalin '*'
CORS_ORIGINS=http://localhost:3001
# Production: ugu yaraan 32 xaraf oo random ah (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
# OTP SMS: 'console' = OTP waxaa lagu qoraa logs (DEV KALIYA); 'none' = ma dirto (production waa inuu isticmaalaa provider dhab ah)
SMS_PROVIDER=console
# Swagger (/api/docs): default = true marka NODE_ENV != production
SWAGGER_ENABLED=true

# --- Admin (apps/admin) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
